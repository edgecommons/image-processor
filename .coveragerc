# Coverage is scoped to the CI-testable surface, matching the org convention (edgecommons/AGENTS.md
# validation matrix: "live-infra-only paths are validated on lab/HOST/GREENGRASS and excluded from
# the unit gate; do not lower a gate or exclude testable code to pass — add tests"). The reference
# component modbus-adapter scopes its 90% gate the same way.
#
# The payload-agnostic core (image_processor/pipeline.py: the stages, the tick, the self-echo guard, the route
# parser) and the library-facing wiring's testable parts (route parsing in __init__, the inbound
# handler's guard/count/drop, the dispatch restamp+publish, the metric flush, the connectivity
# provider) are all unit-tested. Only the two live-runtime seams carry a `# pragma: no cover` at
# their definition with an inline reason:
#   - run():        subscribes over a real transport, spawns the worker threads, blocks until shutdown
#   - _run_route(): the per-route worker's infinite queue-drain/tick loop
# Both are exercised by the HOST/GREENGRASS smoke. Nothing testable is excluded.
#
# The ci.yml `coverage` job runs `pytest --cov=image_processor` from this directory, so coverage auto-discovers
# this file; CI and a local `pytest` therefore apply the identical policy.
[run]
source = image_processor

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

# WP5 (sources): image_processor/sources/ is covered in full by tests/sources/. Its only
# `# pragma: no cover` marks are the two `if TYPE_CHECKING:` import blocks and
# `spool._default_observer_factory`, which constructs a live `watchdog` observer -- the real OS
# notification seam. Tests inject a fake observer through the same factory argument, so the
# debounce loop, the nudge handler, and the periodic walk are all exercised.

# WP4b (engine): image_processor/engine/{protocol,cell,cell_main,supervisor,residency,scheduler}.py
# are covered by tests/engine/ at 97-100% each. The `# pragma: no cover` marks are all live seams
# with an inline reason: `cell_main.cell_entrypoint` (the spawned child's first frame -- the
# handlers and the request loop it calls are covered in process), the NVML readings in
# `residency.NvmlProbe` (no GPU in CI; covered by the EC_NVIDIA suite), the runtime device lookup
# in `CellState.device_class`, and the kill-a-wedged-child and close-a-closed-pipe branches in
# `cell.py`. Nothing testable is excluded.

# WP6 (wiring): image_processor/{ImageProcessor,artifacts,commands,metrics,health,connectivity}.py
# and image_processor/outputs/ are covered by tests/wiring/ and tests/outputs/. There is no
# `# pragma: no cover` in any of them: the live seams they used to need -- the transport, the
# executor subprocess, the vault -- are reached through injected collaborators, so the fake bus in
# tests/wiring/conftest.py exercises the same code the HOST smoke does. What remains uncovered is
# a handful of defensive `except` branches around a collaborator failing in a way no test can
# stage without breaking the collaborator itself.
